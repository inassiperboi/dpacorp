+<style>
+    .hero-scene { position:absolute; inset:0; z-index:0; overflow:hidden; }
+
+    /* Drifting clouds */
+    .hero-cloud { position:absolute; border-radius:999px; background:rgba(255,255,255,.18); filter:blur(2px); }
+    .hero-cloud-1 { width:220px; height:60px; top:8%;  left:-260px; animation:cloudDrift 40s linear infinite; }
+    .hero-cloud-2 { width:160px; height:44px; top:20%; left:-200px; animation:cloudDrift 55s linear infinite 8s; opacity:.7; }
+    .hero-cloud-3 { width:280px; height:70px; top:38%; left:-320px; animation:cloudDrift 65s linear infinite 20s; opacity:.5; }
+    .hero-cloud-4 { width:190px; height:50px; top:55%; left:-220px; animation:cloudDrift 48s linear infinite 30s; opacity:.6; }
+    @keyframes cloudDrift {
+        0%   { transform:translateX(0); }
+        100% { transform:translateX(calc(100vw + 320px)); }
+    }
+
+    /* Dashed flight trails behind the planes */
+    .hero-trail { position:absolute; inset:0; width:100%; height:100%; z-index:0; }
+
+    /* Flying planes */
+    .hero-plane { position:absolute; will-change:transform; }
+    .hero-plane-1 { top:32%; left:-40px; animation:plane1Move 26s linear infinite; }
+    .hero-plane-2 { top:70%; left:-30px; animation:plane2Move 34s linear infinite 10s; }
+    @keyframes plane1Move {
+        0%   { transform:translate(0,0) rotate(-18deg); opacity:0; }
+        6%   { opacity:1; }
+        94%  { opacity:1; }
+        100% { transform:translate(calc(100vw + 80px), -260px) rotate(-18deg); opacity:0; }
+    }
+    @keyframes plane2Move {
+        0%   { transform:translate(0,0) rotate(-10deg); opacity:0; }
+        6%   { opacity:1; }
+        94%  { opacity:1; }
+        100% { transform:translate(calc(100vw + 60px), -120px) rotate(-10deg); opacity:0; }
+    }
+
+    /* City skyline + twinkling windows */
+    .hero-skyline { position:absolute; left:0; right:0; bottom:60px; width:100%; height:22%; min-height:140px; }
+    .hero-window circle { animation:twinkle 3.4s ease-in-out infinite; }
+    .hero-window circle:nth-child(odd) { animation-delay:1.1s; }
+    .hero-window circle:nth-child(3n) { animation-delay:2s; }
+    @keyframes twinkle { 0%, 100% { opacity:.25; } 50% { opacity:1; } }
+
+    /* Road with moving lane markings + driving truck */
+    .hero-road { position:absolute; left:0; right:0; bottom:0; height:60px; background:linear-gradient(to bottom, rgba(9,20,50,.6), rgba(9,20,50,.85)); }
+    .hero-road::after {
+        content:''; position:absolute; top:50%; left:0; right:0; height:2px;
+        background:repeating-linear-gradient(90deg, rgba(255,255,255,.5) 0 24px, transparent 24px 48px);
+        animation:roadLines 1.4s linear infinite;
+    }
+    @keyframes roadLines { 0% { background-position:0 0; } 100% { background-position:-48px 0; } }
+    .hero-truck { position:absolute; bottom:14px; left:-80px; animation:truckDrive 18s linear infinite 3s; }
+    @keyframes truckDrive {
+        0%   { transform:translateX(0); opacity:0; }
+        6%   { opacity:1; }
+        94%  { opacity:1; }
+        100% { transform:translateX(calc(100vw + 100px)); opacity:0; }
+    }
+
+    @media (prefers-reduced-motion: reduce) {
+        .hero-cloud, .hero-plane, .hero-truck, .hero-window circle { animation:none !important; }
+        .hero-road::after { animation:none !important; }
+    }
+</style>
